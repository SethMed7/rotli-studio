# rotli studio (hosted snapshot): static, read-only, unlisted. Railway sets $PORT.
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
	# source and docs are shown as text, never executed or downloaded as video/mp2t
	@code path *.ts *.mjs *.py *.md
	header @code Content-Type "text/plain; charset=utf-8"
	@media path *.mp4 *.jpg *.png *.woff2 *.ttf *.svg
	header @media Cache-Control "public, max-age=3600"
	# pages, data and docs must never be served stale by the CDN (a removed file has to disappear)
	@fresh not path *.mp4 *.jpg *.png *.woff2 *.ttf *.svg /build/*
	header @fresh Cache-Control "no-store"
	@hashed path /build/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	rewrite /motion /index.html
	file_server
}
